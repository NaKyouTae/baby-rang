# Server
PORT=18080

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Kakao OAuth
KAKAO_CLIENT_ID="YOUR_KAKAO_REST_API_KEY"
KAKAO_CALLBACK_URL="http://localhost:18080/auth/kakao/callback"

# Apple Sign In (Guideline 4.8)
# CLIENT_ID 는 App ID 가 아니라 "Services ID" (예: kr.spectrify.baby-rang.web)
APPLE_CLIENT_ID="kr.spectrify.baby-rang.web"
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
APPLE_KEY_ID="YOUR_APPLE_KEY_ID"
# .p8 파일 내용 전체. 한 줄로 넣을 땐 줄바꿈을 \n 으로 이스케이프.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL="http://localhost:18080/auth/apple/callback"

# Client (웹앱 URL)
CLIENT_URL="http://localhost:13000"

# JWT
JWT_SECRET="your-jwt-secret-change-this"
JWT_EXPIRES_IN="7d"

# Toss Payments (docs sample test key)
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

