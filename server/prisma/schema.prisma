generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @default(uuid())
  // 소셜(카카오/네이버)에서 받는 회원 정보. 자체 입력 경로는 없다 —
  // 동의항목으로만 채워지므로, 값이 비었다는 건 아직 동의를 받지 못했다는 뜻이다.
  name                   String? // 실명. 필수 동의항목이라 가입 완료된 회원은 항상 존재.
  phone                  String? // 01012345678 형태로 정규화. 필수 동의항목.
  gender                 String? // 'male' | 'female'. 선택 동의항목이라 null 가능.
  ageRange               String? // '20-29' 형태(10년 단위). 선택 동의항목이라 null 가능.
  email                  String?
  profileImage           String?
  parentRole             String? // 'mom' | 'dad' | 'grandmother' | 'grandfather' | 'caregiver' | 'other'
  onboardedAt            DateTime?
  // 동의 시각 — null이면 미동의 또는 철회됨. 필수(terms/privacy)는 회원가입 시 항상 기록.
  termsAgreedAt          DateTime?
  privacyAgreedAt        DateTime?
  marketingAgreedAt      DateTime?
  // 마케팅 동의 만료일 (개인정보보호법 시행령 §48조의2 — 2년 재확인 권장).
  // null이면 미동의 또는 철회. 만료 후엔 발송 대상에서 제외하고 재동의 안내해야 함.
  marketingExpiresAt     DateTime?
  thirdPartyAgreedAt     DateTime?
  // 초기 화면(첫 진입) 설정 — 앱/웹 진입 시 처음 보여줄 화면의 menuId.
  // null이면 기본값(홈). 값 예: 'growth-record' | 'growth-pattern' | 'nursing-room' 등.
  homeMenu               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  accounts               Account[]
  payments               Payment[]
  temperamentSubmissions TemperamentSubmission[]
  navSlots               NavSlot[]
  growthRecords          GrowthRecord[]
  growthQuickButtons     GrowthQuickButton[]
  physicalGrowths        PhysicalGrowth[]
  noticeReads            NoticeRead[]
  consentLogs            ConsentLog[]
  // 그룹 멤버십 — 한 사용자가 여러 그룹에 속할 수 있음.
  // 그룹은 아이를 함께 관리하는 단위 (배우자/조부모 등 공동 양육자).
  groupMemberships       GroupMember[]
  // 본인이 owner인 그룹들. owner 탈퇴 시 다른 멤버에게 자동 이양된다.
  ownedGroups            Group[]                 @relation("groupOwner")

  @@map("users")
}

enum AuthProvider {
  KAKAO
  GOOGLE
  NAVER
  APPLE
}

// 소셜 로그인 연결 — 한 user가 여러 provider를 가질 수 있도록 분리.
// (provider, providerId)는 SNS 측 식별자로 글로벌 유니크.
model Account {
  id           String       @id @default(uuid())
  userId       String
  provider     AuthProvider
  providerId   String
  // 네이버 전용. 회원탈퇴 시 연동해제(grant_type=delete)를 하려면 유효한 토큰이
  // 필요한데, 네이버는 카카오의 admin key 같은 서버 단독 해제 수단이 없다.
  // 로그인할 때마다 최신 값으로 덮어쓴다. (카카오는 KAKAO_ADMIN_KEY 를 쓰므로 null)
  refreshToken String?
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
  THIRD_PARTY
}

// 동의/철회 감사 로그 — append-only.
// 분쟁/감사 시 정보주체가 언제 어떤 항목에 동의·철회했는지 증빙.
model ConsentLog {
  id         String      @id @default(uuid())
  userId     String
  type       ConsentType
  agreed     Boolean
  occurredAt DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, occurredAt])
  @@map("consent_logs")
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String?
  bgColor   String?
  linkUrl   String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@map("banners")
}

enum TestType {
  TEMPERAMENT
  DEVELOPMENT
  UNICORN
}

model Test {
  id                 String   @id @default(uuid())
  type               TestType @default(TEMPERAMENT)
  title              String
  description        String?
  thumbnailUrl       String?
  linkUrl            String
  labels             String[] @default([])
  durationMinMinutes Int?
  durationMaxMinutes Int?
  questionCount      Int?
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("tests")
}

model Notice {
  id          String       @id @default(uuid())
  title       String
  content     String
  isPinned    Boolean      @default(false)
  isPublished Boolean      @default(true)
  publishedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reads       NoticeRead[]

  @@index([isPublished, isPinned, publishedAt])
  @@map("notices")
}

model NoticeRead {
  id       String   @id @default(uuid())
  userId   String
  noticeId String
  readAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId])
  @@map("notice_reads")
}

model NavSlot {
  id        String   @id @default(uuid())
  userId    String
  position  Int
  menuId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@index([userId])
  @@map("nav_slots")
}

enum AgeGroup {
  newborn
  before_first
  after_first
}

enum SubmissionStatus {
  IN_PROGRESS
  COMPLETED
}

model TemperamentSubmission {
  id          String           @id @default(uuid())
  userId      String
  ageGroup    AgeGroup
  childAge    Int?
  status      SubmissionStatus @default(IN_PROGRESS)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers TemperamentAnswer[]
  result  TemperamentResult?

  @@index([userId, createdAt])
  // getHistory: userId + status 필터 + completedAt 정렬 최적화
  @@index([userId, status, completedAt])
  @@map("temperament_submissions")
}

model TemperamentAnswer {
  id           String   @id @default(uuid())
  submissionId String
  questionId   String
  questionNo   Int
  dimension    String
  score        Int
  createdAt    DateTime @default(now())

  submission TemperamentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionNo])
  @@map("temperament_answers")
}

model TemperamentResult {
  id               String    @id @default(uuid())
  submissionId     String    @unique
  primaryType      String
  primaryTypeLabel String
  emotionModifier  Boolean   @default(false)
  isReliable       Boolean   @default(true)
  reliabilityMsg   String?
  scores           Json
  summary          Json
  freeContent      Json
  paidContent      Json?
  isPaid           Boolean   @default(false)
  paymentId        String?
  unlockedAt       DateTime?
  /// 환불로 잠긴 시각. isPaid 는 false 로 되돌리고 이 값으로 "환불됨"과 "미결제"를 구분한다.
  refundedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  submission TemperamentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("temperament_results")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  PARTIAL_REFUNDED
  REFUNDED
}

enum PaymentProductType {
  TEMPERAMENT_REPORT
  WONDER_WEEKS_PREMIUM
  NURSING_ROOM_PREMIUM
  OTHER
}

model Payment {
  id              String             @id @default(uuid())
  userId          String
  childId         String?
  orderId         String             @unique
  productType     PaymentProductType
  productName     String
  productMeta     Json?
  amount          Int
  taxFreeAmount   Int                @default(0)
  vatAmount       Int                @default(0)
  discountAmount  Int                @default(0)
  currency        String             @default("KRW")
  status          PaymentStatus      @default(PENDING)
  provider        String
  method          String?
  paymentKey      String?            @unique
  transactionId   String?
  receiptUrl      String?
  cardCompany     String?
  cardNumberMask  String?
  cardInstallment Int?
  buyerName       String?
  buyerEmail      String?
  buyerTel        String?
  failureCode     String?
  failureMessage  String?
  rawRequest      Json?
  rawResponse     Json?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  requestedAt     DateTime           @default(now())
  approvedAt      DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  child           Child?             @relation(fields: [childId], references: [id], onDelete: SetNull)
  events          PaymentEvent[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([productType])
  @@map("payments")
}

model PaymentEvent {
  id        String        @id @default(uuid())
  paymentId String
  type      String
  status    PaymentStatus
  amount    Int?
  reason    String?
  payload   Json?
  createdAt DateTime      @default(now())
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

model Child {
  id              String           @id @default(uuid())
  // 아이는 그룹에 속한다. 그룹의 모든 멤버가 동등하게 접근 가능.
  // 그룹의 마지막 멤버가 탈퇴하면 그룹과 함께 cascade 삭제.
  groupId         String
  name            String
  gender          String
  birthDate       DateTime         @db.Date
  dueDate         DateTime?        @db.Date
  profileImage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payments        Payment[]
  growthRecords   GrowthRecord[]
  physicalGrowths PhysicalGrowth[]
  room            Room?

  @@index([groupId])
  @@map("children")
}

enum GrowthRecordType {
  BREASTFEEDING
  FORMULA
  BABY_FOOD
  SLEEP
  PUMPED_FEEDING
  PUMPING
  BATH
  HOSPITAL
  TEMPERATURE
  MEDICATION
  DIAPER
  SNACK
  MILK
  WATER
  PLAY
  TUMMY_TIME
  ETC
}

model GrowthRecord {
  id        String           @id @default(uuid())
  // 작성자(createdBy 역할). 탈퇴 시 SetNull → "(탈퇴한 회원)"으로 표시.
  // 권한 체크는 child.group 멤버십으로 함.
  userId    String?
  childId   String
  type      GrowthRecordType
  startAt   DateTime
  endAt     DateTime?
  memo      String?
  imageUrl  String?
  imageUrls String[]         @default([])
  data      Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, startAt])
  @@index([userId, startAt])
  // recentAmounts: childId + type 필터 + startAt 정렬 최적화
  @@index([childId, type, startAt])
  @@map("growth_records")
}

enum NursingRoomReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model NursingRoomReport {
  id             String                  @id @default(uuid())
  userId         String?
  name           String
  type           String
  sido           String
  sigungu        String?
  roadAddress    String
  detailLocation String?
  tel            String?
  dadAvailable   Boolean                 @default(false)
  facilities     String[]                @default([])
  openHours      String?
  notes          String?
  reporterName   String?
  lat            Float?
  lng            Float?
  status         NursingRoomReportStatus @default(PENDING)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, createdAt])
  @@map("nursing_room_reports")
}

model GrowthQuickButton {
  id        String           @id @default(uuid())
  userId    String
  type      GrowthRecordType
  position  Int
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@unique([userId, position])
  @@index([userId])
  @@map("growth_quick_buttons")
}

// 아이를 공동 양육하는 단위. 회원가입 시 1인 그룹 자동 생성.
// 한 사용자가 여러 그룹에 속할 수 있다 (친정/시댁 등).
// owner는 추방·코드 재발급 권한을 가지며, owner 탈퇴 시 가장 먼저 합류한 멤버에게 자동 이양된다.
model Group {
  id        String   @id @default(uuid())
  ownerId   String
  code      String   @unique
  createdAt DateTime @default(now())

  // NoAction: owner 탈퇴 전에 코드 레벨에서 명시적으로 다른 멤버로 이양해야 함.
  // (이양 실패 시 FK 제약 위반 → user 삭제 거부 → 데이터 보호)
  owner    User          @relation("groupOwner", fields: [ownerId], references: [id], onDelete: NoAction)
  members  GroupMember[]
  children Child[]

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model PhysicalGrowth {
  id           String   @id @default(uuid())
  // 작성자(createdBy 역할). 탈퇴 시 SetNull. 권한 체크는 child.group 기준.
  userId       String?
  childId      String
  measuredAt   DateTime @db.Date
  heightCm     Float?
  weightKg     Float?
  headCircumCm Float?
  memo         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  // measuredAt desc 정렬(findAll)에 맞춘 내림차순 인덱스
  @@index([childId, measuredAt(sort: Desc)])
  @@map("physical_growths")
}

/// 자주 묻는 질문. 어드민에서 직접 등록·수정하고, 앱의 /settings/faq 와
/// FAQPage 구조화 데이터(AEO)가 같은 데이터를 쓴다.
model Faq {
  id          String   @id @default(uuid())
  /// 화면에서 묶어 보여줄 분류. 자유 입력(예: 기질 검사, 결제/환불).
  category    String   @default("일반")
  question    String
  answer      String
  /// 같은 분류 안에서의 노출 순서. 작을수록 위.
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, category, order])
  @@map("faqs")
}

/// AI 크롤러(GPTBot, ClaudeBot 등) 방문 집계.
///
/// robots.txt 로 허용만 해두면 실제로 오는지 알 수 없다. AEO 작업의 효과를
/// 판단하려면 유입 자체를 재야 하므로 (봇, 경로, 날짜) 단위로 횟수를 센다.
/// 요청마다 행을 쌓으면 금방 불어나므로 일자별로 합산한다.
model CrawlerVisit {
  id         String   @id @default(uuid())
  /// 정규화한 봇 이름. User-Agent 원문이 아니다.
  bot        String
  path       String
  date       DateTime @db.Date
  count      Int      @default(1)
  lastSeenAt DateTime @default(now())

  @@unique([bot, path, date])
  @@index([date(sort: Desc), bot])
  @@map("crawler_visits")
}

// ===== 방 꾸미기 =====
//
// 방에 놓을 수 있는 것들의 마스터 카탈로그. 운영자가 어드민에서 관리하며
// 사용자 데이터가 아니다. 사용자가 어디에 놓았는지(RoomPlacement)는 별도 테이블이고,
// 여기에는 "그게 무엇인가"만 둔다. 둘을 한 테이블에 합치면 가격을 바꿀 때
// 이미 산 사람 데이터까지 같이 바뀐다.

enum RoomItemCategory {
  FURNITURE
  DECOR
  RUG
  WINDOW
  TOY
  WALLPAPER
  FLOORING
  // 방 전체 배경. 좌표가 없고 화면을 꽉 채우며, 방에 하나만 적용된다.
  ROOM
}

// 어디에 붙는가. 벽에 거는 것과 바닥에 놓는 것은 좌표의 의미가 다르다.
enum RoomSurface {
  FLOOR
  WALL
  ON_TOP // 다른 가구 위에 올리는 소품
}

enum RoomItemUnlock {
  FREE
  REWARD // 기록·성장 이벤트로 해금
  PURCHASE
  EVENT // 기간 한정
}

// 픽셀 스프라이트는 방향별 그림이 따로 있다. 임의 각도 회전은 불가능하므로
// 각도(0~360)가 아니라 4방향으로 둔다.
enum RoomDirection {
  SOUTH // 정면 — 기본값
  EAST
  NORTH
  WEST
}

// 그림이 실시간 데이터로 바뀌는 슬롯. 창문은 현재 날씨·시간대를 그린다.
enum RoomDynamicSlot {
  WEATHER
  PHOTO
  GROWTH
}

model RoomItem {
  id          String           @id @default(uuid())
  // 코드에서 스프라이트를 찾는 키. 표시 이름이 바뀌어도 이건 고정이다.
  spriteKey   String           @unique
  name        String
  category    RoomItemCategory
  surface     RoomSurface      @default(FLOOR)
  // 바닥에서 차지하는 칸 수. 픽셀로 두면 타일 크기를 바꿀 때 전부 깨진다.
  tileW       Int              @default(1)
  tileH       Int              @default(1)
  // 그림이 바닥 칸보다 위로 솟는 높이(타일). 옷장처럼 키 큰 가구용.
  spriteLiftY Int              @default(0)
  // 지원하는 방향. 그림이 한 장뿐이면 [SOUTH] 만 넣는다.
  directions  RoomDirection[]  @default([SOUTH])
  // 방향 그림 없이 좌우 반전만 되는 아이템
  flippable   Boolean          @default(false)
  // 위에 소품을 올릴 수 있는가 (책상·선반)
  canStack    Boolean          @default(false)
  dynamicSlot RoomDynamicSlot?
  // 스프라이트 이미지 경로. 코드로 그리는 동안은 비워 두고 spriteKey 로만 찾는다.
  // 바이너리는 DB 에 넣지 않는다.
  imageUrl    String?
  unlock      RoomItemUnlock   @default(FREE)
  priceCoins  Int?
  sortOrder   Int              @default(0)
  // 지우지 말고 이걸 끈다. 삭제하면 이미 배치된 방이 깨진다.
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  placements RoomPlacement[]
  rooms      Room[]

  @@index([category, isActive])
  @@map("room_items")
}

/// 아이 한 명의 방. Child 와 1:1.
model Room {
  id      String @id @default(uuid())
  childId String @unique
  /// 방 전체 배경(방 타입). 좌표가 없어 배치가 아니라 방의 속성이다.
  roomItemId String?
  /// 공동 양육자가 동시에 편집할 때 덮어쓰기를 막는 낙관적 잠금
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child      Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  roomItem   RoomItem?       @relation(fields: [roomItemId], references: [id])
  placements RoomPlacement[]

  @@index([roomItemId])
  @@map("rooms")
}

/// 방에 놓인 가구 한 개.
/// 같은 아이템을 여러 개 놓을 수 있으므로 (roomId, itemId) 에 unique 를 걸면 안 된다.
model RoomPlacement {
  id     String @id @default(uuid())
  roomId String
  itemId String
  /// 타일 좌표(왼쪽 위 기준). 픽셀로 저장하면 타일 크기를 바꿀 때 전부 깨진다.
  tileX     Int
  tileY     Int
  direction RoomDirection @default(SOUTH)
  flipX     Boolean       @default(false)
  /// 같은 칸에서 그리기 순서가 꼬일 때만 쓰는 미세 조정값.
  /// 기본 순서는 tileY 로 계산한다 — 통째로 저장하면 좌표와 어긋난다.
  zOffset   Int           @default(0)
  createdAt DateTime      @default(now())

  room Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  item RoomItem @relation(fields: [itemId], references: [id])

  @@index([roomId])
  @@index([itemId])
  @@map("room_placements")
}
