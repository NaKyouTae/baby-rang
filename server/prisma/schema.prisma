generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  nickname      String?
  email         String?
  profileImage  String?
  parentRole    String?  // 'mom' | 'dad' | 'grandmother' | 'grandfather' | 'caregiver' | 'other'
  birthYear     Int?
  onboardedAt   DateTime?
  // 동의 시각 — null이면 미동의 또는 철회됨. 필수(terms/privacy)는 회원가입 시 항상 기록.
  termsAgreedAt        DateTime?
  privacyAgreedAt      DateTime?
  marketingAgreedAt    DateTime?
  // 마케팅 동의 만료일 (개인정보보호법 시행령 §48조의2 — 2년 재확인 권장).
  // null이면 미동의 또는 철회. 만료 후엔 발송 대상에서 제외하고 재동의 안내해야 함.
  marketingExpiresAt   DateTime?
  thirdPartyAgreedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accounts      Account[]
  payments      Payment[]
  temperamentSubmissions TemperamentSubmission[]
  navSlots      NavSlot[]
  growthRecords GrowthRecord[]
  growthQuickButtons GrowthQuickButton[]
  physicalGrowths PhysicalGrowth[]
  noticeReads   NoticeRead[]
  consentLogs   ConsentLog[]
  // 그룹 멤버십 — 한 사용자가 여러 그룹에 속할 수 있음.
  // 그룹은 아이를 함께 관리하는 단위 (배우자/조부모 등 공동 양육자).
  groupMemberships GroupMember[]
  // 본인이 owner인 그룹들. owner 탈퇴 시 다른 멤버에게 자동 이양된다.
  ownedGroups   Group[]            @relation("groupOwner")

  @@map("users")
}

enum AuthProvider {
  KAKAO
  GOOGLE
  NAVER
  APPLE
}

// 소셜 로그인 연결 — 한 user가 여러 provider를 가질 수 있도록 분리.
// (provider, providerId)는 SNS 측 식별자로 글로벌 유니크.
model Account {
  id         String       @id @default(uuid())
  userId     String
  provider   AuthProvider
  providerId String
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
  THIRD_PARTY
}

// 동의/철회 감사 로그 — append-only.
// 분쟁/감사 시 정보주체가 언제 어떤 항목에 동의·철회했는지 증빙.
model ConsentLog {
  id          String      @id @default(uuid())
  userId      String
  type        ConsentType
  agreed      Boolean
  occurredAt  DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, occurredAt])
  @@map("consent_logs")
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  imageUrl    String?
  bgColor     String?
  linkUrl     String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("banners")
}

enum TestType {
  TEMPERAMENT
  DEVELOPMENT
  UNICORN
}

model Test {
  id                 String   @id @default(uuid())
  type               TestType @default(TEMPERAMENT)
  title              String
  description        String?
  thumbnailUrl       String?
  linkUrl            String
  labels             String[] @default([])
  durationMinMinutes Int?
  durationMaxMinutes Int?
  questionCount      Int?
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("tests")
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  content     String
  isPinned    Boolean  @default(false)
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reads       NoticeRead[]

  @@index([isPublished, isPinned, publishedAt])
  @@map("notices")
}

model NoticeRead {
  id        String   @id @default(uuid())
  userId    String
  noticeId  String
  readAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId])
  @@map("notice_reads")
}

model NavSlot {
  id        String   @id @default(uuid())
  userId    String
  position  Int
  menuId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@index([userId])
  @@map("nav_slots")
}

enum AgeGroup {
  newborn
  before_first
  after_first
}

enum SubmissionStatus {
  IN_PROGRESS
  COMPLETED
}

model TemperamentSubmission {
  id          String           @id @default(uuid())
  userId      String
  ageGroup    AgeGroup
  childAge    Int?
  status      SubmissionStatus @default(IN_PROGRESS)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers TemperamentAnswer[]
  result  TemperamentResult?

  @@index([userId, createdAt])
  // getHistory: userId + status 필터 + completedAt 정렬 최적화
  @@index([userId, status, completedAt])
  @@map("temperament_submissions")
}

model TemperamentAnswer {
  id           String   @id @default(uuid())
  submissionId String
  questionId   String
  questionNo   Int
  dimension    String
  score        Int
  createdAt    DateTime @default(now())

  submission TemperamentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionNo])
  @@map("temperament_answers")
}

model TemperamentResult {
  id              String    @id @default(uuid())
  submissionId    String    @unique
  primaryType     String
  primaryTypeLabel String
  emotionModifier Boolean   @default(false)
  isReliable      Boolean   @default(true)
  reliabilityMsg  String?
  scores          Json
  summary         Json
  freeContent     Json
  paidContent     Json?
  isPaid          Boolean   @default(false)
  paymentId       String?
  unlockedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  submission TemperamentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("temperament_results")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  PARTIAL_REFUNDED
  REFUNDED
}

enum PaymentProductType {
  TEMPERAMENT_REPORT
  WONDER_WEEKS_PREMIUM
  NURSING_ROOM_PREMIUM
  OTHER
}

model Payment {
  id              String             @id @default(uuid())
  userId          String
  childId         String?
  orderId         String             @unique
  productType     PaymentProductType
  productName     String
  productMeta     Json?
  amount          Int
  taxFreeAmount   Int                @default(0)
  vatAmount       Int                @default(0)
  discountAmount  Int                @default(0)
  currency        String             @default("KRW")
  status          PaymentStatus      @default(PENDING)
  provider        String
  method          String?
  paymentKey      String?            @unique
  transactionId   String?
  receiptUrl      String?
  cardCompany     String?
  cardNumberMask  String?
  cardInstallment Int?
  buyerName       String?
  buyerEmail      String?
  buyerTel        String?
  failureCode     String?
  failureMessage  String?
  rawRequest      Json?
  rawResponse     Json?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  requestedAt     DateTime           @default(now())
  approvedAt      DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  child           Child?             @relation(fields: [childId], references: [id], onDelete: SetNull)
  events          PaymentEvent[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([productType])
  @@map("payments")
}

model PaymentEvent {
  id          String   @id @default(uuid())
  paymentId   String
  type        String
  status      PaymentStatus
  amount      Int?
  reason      String?
  payload     Json?
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

model Child {
  id            String   @id @default(uuid())
  // 아이는 그룹에 속한다. 그룹의 모든 멤버가 동등하게 접근 가능.
  // 그룹의 마지막 멤버가 탈퇴하면 그룹과 함께 cascade 삭제.
  groupId       String
  name          String
  gender        String
  birthDate     DateTime @db.Date
  dueDate       DateTime? @db.Date
  profileImage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payments      Payment[]
  growthRecords GrowthRecord[]
  physicalGrowths PhysicalGrowth[]

  @@index([groupId])
  @@map("children")
}

enum GrowthRecordType {
  BREASTFEEDING
  FORMULA
  BABY_FOOD
  SLEEP
  PUMPED_FEEDING
  PUMPING
  BATH
  HOSPITAL
  TEMPERATURE
  MEDICATION
  DIAPER
  SNACK
  MILK
  WATER
  PLAY
  TUMMY_TIME
  ETC
}

model GrowthRecord {
  id        String           @id @default(uuid())
  // 작성자(createdBy 역할). 탈퇴 시 SetNull → "(탈퇴한 회원)"으로 표시.
  // 권한 체크는 child.group 멤버십으로 함.
  userId    String?
  childId   String
  type      GrowthRecordType
  startAt   DateTime
  endAt     DateTime?
  memo      String?
  imageUrl  String?
  imageUrls String[] @default([])
  data      Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  child Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, startAt])
  @@index([userId, startAt])
  // recentAmounts: childId + type 필터 + startAt 정렬 최적화
  @@index([childId, type, startAt])
  @@map("growth_records")
}

enum NursingRoomReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model NursingRoomReport {
  id             String                  @id @default(uuid())
  userId         String?
  name           String
  type           String
  sido           String
  sigungu        String?
  roadAddress    String
  detailLocation String?
  tel            String?
  dadAvailable   Boolean                 @default(false)
  facilities     String[]                @default([])
  openHours      String?
  notes          String?
  reporterName   String?
  lat            Float?
  lng            Float?
  status         NursingRoomReportStatus @default(PENDING)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, createdAt])
  @@map("nursing_room_reports")
}

model GrowthQuickButton {
  id        String           @id @default(uuid())
  userId    String
  type      GrowthRecordType
  position  Int
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@unique([userId, position])
  @@index([userId])
  @@map("growth_quick_buttons")
}

// 아이를 공동 양육하는 단위. 회원가입 시 1인 그룹 자동 생성.
// 한 사용자가 여러 그룹에 속할 수 있다 (친정/시댁 등).
// owner는 추방·코드 재발급 권한을 가지며, owner 탈퇴 시 가장 먼저 합류한 멤버에게 자동 이양된다.
model Group {
  id        String   @id @default(uuid())
  ownerId   String
  code      String   @unique
  createdAt DateTime @default(now())

  // NoAction: owner 탈퇴 전에 코드 레벨에서 명시적으로 다른 멤버로 이양해야 함.
  // (이양 실패 시 FK 제약 위반 → user 삭제 거부 → 데이터 보호)
  owner    User          @relation("groupOwner", fields: [ownerId], references: [id], onDelete: NoAction)
  members  GroupMember[]
  children Child[]

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model PhysicalGrowth {
  id              String   @id @default(uuid())
  // 작성자(createdBy 역할). 탈퇴 시 SetNull. 권한 체크는 child.group 기준.
  userId          String?
  childId         String
  measuredAt      DateTime @db.Date
  heightCm        Float?
  weightKg        Float?
  headCircumCm    Float?
  memo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  child Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  // measuredAt desc 정렬(findAll)에 맞춘 내림차순 인덱스
  @@index([childId, measuredAt(sort: Desc)])
  @@map("physical_growths")
}
