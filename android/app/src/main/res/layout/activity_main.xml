<?xml version="1.0" encoding="utf-8"?>
<!--
  WebView 위에 네이티브 배너를 얹을 수 있도록 FrameLayout 으로 겹쳐 둔다.
  iOS 와 같은 구조: 웹이 알려주는 슬롯 좌표에 배너를 배치한다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 광고 배너 자리. AdMob 연동 시 여기에 AdView 를 붙인다. -->
    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <!--
      스플래시 이미지.

      시스템 스플래시(Theme.BabyRang.Starting)는 Android 12+ 규격상
      '배경색 + 가운데 아이콘' 밖에 못 쓴다. 그 뒤 WebView 가 첫 화면을 그릴 때까지
      비어 있는 구간을 이 이미지로 덮는다. iOS 가 Launch Screen → SwiftUI SplashView
      로 이어받는 것과 같은 구조다.

      웹의 SplashProvider 가 같은 이미지를 이어서 보여주므로 전환이 끊기지 않는다.
      맨 마지막에 두어야 WebView·배너 위에 덮인다.
    -->
    <ImageView
        android:id="@+id/splashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_background"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/splash" />
</FrameLayout>
