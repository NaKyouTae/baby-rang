<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>kr.spectrify.baby-rang</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>babyrang</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>kakao</string>
			<!-- 카카오톡이 로그인 인증을 마친 뒤 이 스킴으로 앱에 돌아온다.
			     kakao + 네이티브 앱 키. 카카오 개발자 콘솔의 '스킴' 값과 같아야 한다.
			     키는 빌드 설정 KAKAO_NATIVE_APP_KEY 에서 온다(Debug=개발 앱, Release=운영 앱).
			     여기에 직접 적지 않는 이유: 스킴과 initSDK 에 쓰는 키가 어긋나면
			     카카오톡은 열리는데 앱으로 돌아오지 못한다. 한 곳에서만 정의한다. -->
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kakao$(KAKAO_NATIVE_APP_KEY)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>naver</string>
			<!-- 네이버앱이 인증을 마친 뒤 이 스킴으로 앱에 돌아온다.
			     네이버 개발자센터의 'iOS URL Scheme' 값과 반드시 같아야 한다.
			     SDK 초기화 때 serviceUrlScheme 으로도 같은 값을 넘긴다(BabyRangApp.swift). -->
			<key>CFBundleURLSchemes</key>
			<array>
				<string>babyrangnaver</string>
			</array>
		</dict>
	</array>
	<!-- 카카오 네이티브 앱 키. 빌드 구성별로 다른 값이 들어간다.
	     BabyRangApp 이 KakaoSDK.initSDK 에 넘길 때 읽는다. -->
	<key>KakaoNativeAppKey</key>
	<string>$(KAKAO_NATIVE_APP_KEY)</string>
	<!-- 네이버 로그인 키. 빌드 설정에서 주입한다(카카오와 같은 방식).
	     비밀값이 아니다 — 앱 바이너리에 그대로 실려 나가고, 네이버의 보안 경계는
	     개발자센터에 등록한 번들 ID 와 URL 스킴이다. -->
	<key>NaverConsumerKey</key>
	<string>$(NAVER_CONSUMER_KEY)</string>
	<key>NaverConsumerSecret</key>
	<string>$(NAVER_CONSUMER_SECRET)</string>
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-6008464533427245~7115583932</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaokompassauth</string>
		<string>kakaotalk</string>
		<!-- 네이버앱 설치 여부 확인. 이 선언이 없으면 네이버앱이 깔려 있어도
		     인앱 웹뷰 로그인으로 빠진다(iOS 는 선언 없이 다른 앱을 조회할 수 없다). -->
		<string>naversearchapp</string>
		<string>naversearchthirdlogin</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>주변 수유실을 찾기 위해 위치 정보가 필요합니다.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>관심에 맞는 광고를 보여드리기 위해 사용됩니다. 허용하지 않아도 앱의 모든 기능을 그대로 이용할 수 있습니다.</string>
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
